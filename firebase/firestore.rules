rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a real account. The speaking drill signs in
    // anonymously only to call the scoring function (PIN-9), so an
    // anonymous user counts as signed out for every rule. With no sign-in,
    // reading request.auth.uid is an error, and an error denies.
    function signedIn() {
      return request.auth.uid != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{document} {
      allow create: if signedIn() && request.auth.uid == document;
      // Was `if true`: every profile in the app, including email, phone
      // number, birthday and photo, was readable by anyone on the internet
      // who knew the project id. Signed-in is the minimum that still lets
      // members see each other in groups and chats.
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == document;
      allow delete: if signedIn() && request.auth.uid == document;
    }

    match /articles/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /celebration_suggestions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /chat_messages/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    match /chats/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    match /checkins/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    match /goals/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    match /group_member_state/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if false;
    }

    match /habits/{document} {
      allow create: if true;
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if signedIn();
    }

    match /user_group_search/{document} {
      allow create: if true;
      // Who belongs to which group. Was world-readable.
      allow read: if signedIn();
      allow write: if false;
      allow delete: if false;
    }

    match /groups/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /feelings/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /icons/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /categories/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /lessons/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /application_messages/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /reminders/{document} {
      allow create: if true;
      // What someone does and when. The scheduler runs as a Cloud Function on
      // the admin SDK, which bypasses rules, so tightening this does not
      // affect notifications.
      allow read: if signedIn();
      allow write: if false;
      allow delete: if false;
    }

    match /users/{parent}/user_activity/{document} {
      allow create: if signedIn() && request.auth.uid == parent;
      // Every check-in a person has ever made. Was world-readable.
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == parent;
      allow delete: if signedIn() && request.auth.uid == parent;
    }

    match /chat_messages/{parent}/flags/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/flags/{document} {
      allow read: if true;
    }


    match /webinars/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /monthly_challenges/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /chat_messages/{parent}/reactions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/reactions/{document} {
      allow read: if true;
    }


    // The synced Japanese record (docs/plans/2026-11-19-jp-web-sync.md).
    // Only the owner, signed in with a real account, may touch it, and only
    // while users/{uid} exists: account delete removes the profile, so a
    // device still signed in cannot write after the cleanup (PIN-13).
    // The users rule still lets that device recreate users/{uid}, so the
    // account-delete cleanup also writes deleted_accounts/{uid} first, and
    // no request passes while that marker exists.
    function jpOwner(uid) {
      return signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(uid))
          && !exists(/databases/$(database)/documents/deleted_accounts/$(uid));
    }

    // Written only by the account-delete cleanup on the admin SDK, which
    // skips rules. No client may read or write a marker.
    match /deleted_accounts/{uid} {
      allow read, write: if false;
    }

    // The event log is append-only (PIN-3): no update, no client delete.
    // Account delete removes events with the admin SDK, which skips rules.
    match /users/{uid}/jp_events/{eventId} {
      allow read: if jpOwner(uid);
      allow create: if jpOwner(uid);
    }

    // One local day's plan. The first plan to reach the server wins, so the
    // document is created once. After that only position (forward) and
    // completed (on, never off) may change (PIN-10).
    match /users/{uid}/jp_days/{day} {
      allow read: if jpOwner(uid);
      allow create: if jpOwner(uid)
          && request.resource.data.position is int
          && request.resource.data.completed is bool;
      allow update: if jpOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['position', 'completed'])
          && request.resource.data.position is int
          && request.resource.data.position >= resource.data.position
          && request.resource.data.completed is bool
          && (request.resource.data.completed || !resource.data.completed);
    }

    // Each device's last sync time, for the devices page.
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if jpOwner(uid);
    }

    match /ff_user_push_notifications/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn() && /databases/$(database)/documents/users/$(request.auth.uid) == request.resource.data.sender;
    }
  }
}
