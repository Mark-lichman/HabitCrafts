rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /users/{userId}/{allPaths=**} {
      // Profile photos and anything attached to a message. Was readable by
      // anyone with the URL pattern; signed-in still lets members see each
      // other's avatars.
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}