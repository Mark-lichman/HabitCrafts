# Params for the emulators only. The rules tests (firebase/rules-tests) run on
# the demo-habitcrafts project, and the Functions emulator stops to prompt for
# any string param with no value. This file answers that prompt. A deploy to
# the real project reads .env.<real project id>, never this file, and the
# scoring function is never called in the emulator suite.
AZURE_SPEECH_REGION=emulator
