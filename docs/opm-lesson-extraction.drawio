        <mxCell id="OPT2" value="&lt;b&gt;Optimizing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;DSPy compile, offline&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205" y="840" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="CP2" value="&lt;b&gt;Compiled Program&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;spec_version: str&lt;br&gt;signature + instructions + demos&lt;br&gt;one per LM module&lt;br&gt;NOT a data object &amp;#8212; it is the module&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="970" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="G5" value="&lt;b&gt;MISSING &amp;#8212; Attempt Record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;A low correct-rate confounds &quot;hard item&quot; with &quot;broken item&quot;. Optimizing on raw attempts drifts toward easy items. Calibrate difficulty, or restrict the signal to reported_broken.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="G6" value="&lt;b&gt;MISSING &amp;#8212; Gold Example.rubric&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;rubric is a free-text str doing the judge's whole job. One rubric per metric, or one per gold example? Until this is settled, every JUDGE metric above is a stub.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="e88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=oval;endFill=0;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GOLD" target="F2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ER2" target="OPT2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1246" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ATT2" target="OPT2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="OPT2" target="CP2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e92" value="recompiled, to every LM module" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=oval;endFill=0;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CP2" target="F2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="V2" target="ER2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1055"/><mxPoint x="1100" y="555"/></Array></mxGeometry></mxCell>
        <mxCell id="LEG2" value="&lt;b&gt;DET vs JUDGE&lt;/b&gt;&lt;br&gt;DET metrics are plain Python and cost nothing &amp;#8212; write them first, they catch more than the judge will.&lt;br&gt;JUDGE metrics need an LM and a rubric, and every one of them is blocked on the gap above." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="260" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="SD3 &#8212; Structured Sources" id="opd-sd3">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1600" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="F3" value="&lt;b&gt;SD3 &amp;#8212; Structured Sources&lt;/b&gt; &amp;#8212; Normalizing in-zoomed by source shape, plus the tutor path that skips Mining. Code: &lt;i&gt;pipeline/jp/&lt;/i&gt;." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=12 6;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="40" width="1120" height="1500" as="geometry"/></mxCell>
        <mxCell id="X0" value="&lt;b&gt;Source Document&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;shape: text &amp;#124; picture table &amp;#124; image &amp;#124; sheet&lt;br&gt;detected from the file, not guessed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="N1" value="&lt;b&gt;Normalizing (text)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;PyMuPDF geometry, never a stream&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="N2" value="&lt;b&gt;Normalizing (picture table)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;render + sample cell fill&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="N3" value="&lt;b&gt;Transcribing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;vision; no text layer&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="N4" value="&lt;b&gt;Normalizing (sheet)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;merged cells, links, formulas&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="220" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="Y1" value="&lt;b&gt;Canonical Text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;see SD&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="Y2" value="&lt;b&gt;Canonical Table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;cells: x, y, fill class, lines&lt;br&gt;fill class is DATA (legend: sound change, special)&lt;br&gt;header cells merged per column&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="OCR" value="&lt;b&gt;OCR Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;Windows.Media.Ocr ja&lt;br&gt;independent second reading&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="Y4" value="&lt;b&gt;Sheet Table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;rows with merged cells filled&lt;br&gt;hyperlink targets&lt;br&gt;formula + cached value&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1140" y="340" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="T1" value="&lt;b&gt;Table Extracting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;row + column headers to cells&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="T2" value="&lt;b&gt;Curriculum Importing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;given, not mined&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="560" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="R1" value="&lt;b&gt;Reference Item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;number + counter &amp;#8594; reading&lt;br&gt;alt readings&lt;br&gt;mark: regular &amp;#124; sound change &amp;#124; special&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="680" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="R2" value="&lt;b&gt;Verb Pair&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;transitive  &amp;#183; intransitive&lt;br&gt;groups  &amp;#183; gloss&lt;br&gt;example per side&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="680" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="R3" value="&lt;b&gt;Paradigm Cell&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;dictionary form  &amp;#183; group&lt;br&gt;form  &amp;#183; result&lt;br&gt;= gold for the engine&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="680" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="R4" value="&lt;b&gt;Curriculum Spec&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;lesson &amp;#8594; Grammar Point[]&lt;br&gt;pattern  &amp;#183; example  &amp;#183; goal&lt;br&gt;requires_forms (prerequisites)&lt;br&gt;resource: tutor notes link&lt;br&gt;self-check: after class &amp;#124; can use it &amp;#124; review needed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1140" y="680" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="ENG" value="&lt;b&gt;Conjugation Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;plain code, 12 forms&lt;br&gt;group() returns every group that fits;&lt;br&gt;ambiguous verbs never resolve silently&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="870" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="V3" value="&lt;b&gt;Validating (cross-source)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;kana only  &amp;#183; grid complete  &amp;#183; legend consistent&lt;br&gt;engine = tutor gold  &amp;#183; pairs agree across sources&lt;br&gt;examples confirm verb + group&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#808080;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1000" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="A6" value="&lt;b&gt;Lesson Bundle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;one per source, state:&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="1130" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="B6a" value="&lt;b&gt;needs review&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="575" y="1190" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="B6b" value="&lt;b&gt;blocked&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="1190" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="B6c" value="&lt;b&gt;approved&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="1190" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="RV3" value="&lt;b&gt;Reviewing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;review notes name the exact cells&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1290" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="COACH3" value="&lt;b&gt;Coach (Mark)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1300" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="TUT3" value="&lt;b&gt;Tutor (Mari)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1300" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="G7" value="&lt;b&gt;GAP &amp;#8212; image sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;An image has no text layer, so Transcribing is an LM call and its output can never skip Reviewing. The OCR cross-check narrows what a person reads; it does not replace them.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="G8" value="&lt;b&gt;GAP &amp;#8212; external tutor tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d&quot;&gt;Mari's Canva decks (25 links) and the web conjugation drill are linked, not extracted. Canva needs a login; the drill is a third-party page. Keep them as resources until Mari can export.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="LEG3" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;green rectangle = object &amp;#183; yellow = control object &amp;#183; purple cylinder = persistent store&lt;br&gt;&lt;b style=&quot;color:#1f5fa9&quot;&gt;blue ellipse = LM stage&lt;/b&gt; (gets a DSPy signature) &amp;#183; &lt;b style=&quot;color:#666&quot;&gt;grey ellipse = deterministic&lt;/b&gt; (plain code) &amp;#183; &lt;b style=&quot;color:#b07000&quot;&gt;orange ellipse = human&lt;/b&gt;&lt;br&gt;&amp;#8594; solid = consumption / result &amp;#183; &amp;#8596; = effect &amp;#183; &amp;#8212;&amp;#9675; = instrument &amp;#183; &amp;#8212;&amp;#9679; = agent&lt;br&gt;&lt;b style=&quot;color:#e07b00&quot;&gt;&amp;#8212; &amp;#8212;&amp;#8594; orange dashed = asynchronous invocation&lt;/b&gt; (queue hop, carries an Envelope)&lt;br&gt;&lt;b style=&quot;color:#b85450&quot;&gt;red dashed box = a gap the schema could not close&lt;/b&gt; &amp;#8212; see # MISSING in extraction_schemas.py&lt;br&gt;&lt;b&gt;SD3 rule:&lt;/b&gt; a source a tutor wrote is curriculum, not raw text. It enters as given, through a human-authored path, and Mining (an LM) never touches it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="e94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="X0" target="N1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="X0" target="N2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="X0" target="N3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=12;strokeWidth=1.6;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="X0" target="N4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
