  "recipe": [
    "import json, sys",
    "from datetime import datetime, timedelta, timezone",
    "import fsrs",
    "from fsrs import Scheduler, Card, Rating",
    "",
    "# The vendored dart-fsrs 2.0.1 parameter set (lib/fsrs.dart defaultParameters).",
    "PARAMS = [0.2172, 1.1771, 3.2602, 16.1507, 7.0114, 0.57, 2.0966, 0.0069, 1.5261,",
    "          0.112, 1.0178, 1.849, 0.1133, 0.3127, 2.2934, 0.2191, 3.0004, 0.7536,",
    "          0.3332, 0.1437, 0.2]",
    "# (rating, gap in whole days since the previous review; the first gap is ignored)",
    "SEQ = [",
    "  (3, 0), (3, 1), (3, 3), (2, 6), (3, 9), (1, 14), (3, 0), (3, 1), (3, 3), (3, 7),",
    "  (4, 12), (3, 30), (2, 45), (3, 60), (1, 90), (1, 0), (2, 0), (3, 1), (3, 2), (3, 5),",
    "  (3, 20), (1, 3), (3, 1), (2, 1), (3, 4), (3, 9), (3, 0), (4, 2), (3, 40), (1, 120),",
    "  (3, 1), (3, 2), (3, 6), (2, 15), (3, 25), (3, 50), (1, 2), (3, 0), (3, 1), (3, 200),",
    "]",
    "assert len(SEQ) == 40",
    "sched = Scheduler(parameters=PARAMS, desired_retention=0.9, learning_steps=(),",
    "                  relearning_steps=(), maximum_interval=90, enable_fuzzing=False)",
    "card = Card()",
    "t = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)",
    "rows = []",
    "for i, (r, gap) in enumerate(SEQ):",
    "    if i > 0:",
    "        t = t + timedelta(days=gap)",
    "    before = sched.get_card_retrievability(card, t) if i > 0 else None",
    "    card, _ = sched.review_card(card, Rating(r), t)",
    "    interval = (card.due - t).days",
    "    rows.append({\"rating\": r, \"gapDays\": gap if i > 0 else 0,",
    "                 \"retrievabilityBefore\": before,",
    "                 \"stability\": card.stability, \"difficulty\": card.difficulty,",
    "                 \"interval\": interval})",
    "out = {",
    "  \"recorded\": \"2026-11-03\",",
    "  \"source\": f\"py-fsrs {fsrs.__version__ if hasattr(fsrs,'__version__') else '6.3.2'} (pip install fsrs==6.3.2), Python {sys.version.split()[0]}\",",
    "  \"scheduler\": {\"parameters\": PARAMS, \"desiredRetention\": 0.9, \"learningSteps\": [],",
    "                \"relearningSteps\": [], \"maximumInterval\": 90, \"enableFuzzing\": False},",
    "  \"note\": \"Recorded once. Ratings: 1 Again, 2 Hard, 3 Good, 4 Easy. gapDays is the whole days since the previous review (0 = same day). interval is the days to the next due date. The recipe below regenerates this file.\",",
    "  \"recipe\": open(__file__, encoding=\"utf-8\").read().splitlines(),",
    "  \"reviews\": rows,",
    "}",
    "print(json.dumps(out, indent=2))"
  ],
